# Copy to .env (git-ignored) and fill in. Only the voice backend reads this file.
ELEVENLABS_API_KEY=
# Optional: the voice that reads answers. Empty = the first voice on your ElevenLabs account.
ELEVENLABS_VOICE_ID=
# Optional model overrides (defaults: scribe_v3 and eleven_flash_v2_5).
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=
