# Copy to .env (git-ignored) and fill in. Only the backend reads this file.
ELEVENLABS_API_KEY=
# Optional: the voice that reads answers. Empty = Nathaniel C (eIYyt1GDV2CYz5Ccyam2), a calm
# medical-support voice from the ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=
# Optional model overrides (defaults: scribe_v3 and eleven_multilingual_v2; eleven_flash_v2_5 is
# about 0.5 s faster per answer, eleven_v4 more expressive but ~3.5 s per answer).
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=

# Answers to free questions (anything but the suggested ones) come from an LLM through LangChain's
# init_chat_model. LLM_MODEL is "provider:model"; empty = DeepSeek V4.1 Flash (1017) on Fireworks AI.
# GLM 5.3 Flash is fireworks:accounts/fireworks/models/glm-5p3-flash. Another provider needs its
# LangChain package installed (e.g. langchain-openai) and its own key variable.
FIREWORKS_API_KEY=
LLM_MODEL=fireworks:accounts/fireworks/models/deepseek-v4p1-flash-1017
# Free alternative: Groq (console.groq.com/keys, no card). The hosted demo uses
#   GROQ_API_KEY=...  LLM_MODEL=groq:openai/gpt-oss-120b  LLM_REASONING_EFFORT=low
GROQ_API_KEY=
# Optional: how hard a reasoning model thinks. Empty = "none" on Fireworks, the provider default elsewhere.
LLM_REASONING_EFFORT=
