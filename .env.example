# Copy to .env (git-ignored) and fill in. Only the backend reads this file.
ELEVENLABS_API_KEY=
# Optional: the voice that reads answers. Empty = Nathaniel C (eIYyt1GDV2CYz5Ccyam2), a calm
# medical-support voice from the ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=
# Optional model overrides (defaults: scribe_v3 and eleven_multilingual_v2; eleven_flash_v2_5 is
# about 0.5 s faster per answer, eleven_v4 more expressive but ~3.5 s per answer).
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=

# Answers to free questions (anything but the suggested ones) come from an LLM through LangChain's
# init_chat_model. LLM_MODEL is "provider:model"; empty = GLM 5.3 Flash on Fireworks AI. For
# DeepSeek V4.1 Flash use fireworks:accounts/deepseek-ai/models/deepseek-v4p1-flash. Another
# provider needs its LangChain package installed (e.g. langchain-openai) and its own key variable.
FIREWORKS_API_KEY=
LLM_MODEL=fireworks:accounts/fireworks/models/glm-5p3-flash
