{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClinGraph reference event v1",
  "type": "object",
  "required": [
    "id",
    "patient_id",
    "report_id",
    "concept",
    "category",
    "assertion",
    "change",
    "report_date",
    "event_date",
    "evidence",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "concept": {
      "type": "string"
    },
    "review_status": {
      "type": "string"
    },
    "category": {
      "enum": [
        "finding",
        "complication",
        "procedure",
        "device"
      ]
    },
    "assertion": {
      "enum": [
        "present",
        "absent",
        "suspected",
        "historical",
        "unknown"
      ]
    },
    "change": {
      "enum": [
        "first_documented",
        "progressed",
        "stable",
        "improved",
        "performed",
        "unknown",
        "unclear"
      ]
    },
    "report_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "event_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "evidence": {
      "type": "object",
      "required": [
        "sentence_id",
        "quote",
        "start",
        "end"
      ],
      "properties": {
        "sentence_id": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}